<odoo>
    <!-- Menus -->
    <menuitem id="menu_random_team_root" name="Gestion des équipes" sequence="10" />
    <menuitem id="menu_random_team" name="Équipes" parent="menu_random_team_root"
        action="action_random_team" />
    <menuitem id="menu_waiting_register_people" name="Inscriptions en attente"
        parent="menu_random_team_root" action="action_waiting_register_people_form" sequence="20" />
    <menuitem id="menu_team_settings" name="Configurations" parent="menu_random_team_root"
        sequence="30" />

    <!-- Sous menus configuration -->
    <menuitem id="menu_setting" name="Paramètres" parent="menu_team_settings"
        action="action_team_settings" sequence="10" />
    <menuitem id="menu_random_task" name="Tâches" parent="menu_team_settings"
        action="action_random_task" sequence="20" />
    <menuitem id="menu_random_tribe" name="Tribus" parent="menu_team_settings" action="action_tribe"
        sequence="30" />
    <menuitem id="menu_prayer_cell" name="Cellules de Prière" parent="menu_team_settings"
        action="action_prayer_cell" sequence="40" />
    <!-- Ajout au menu (optionnel) -->
    <menuitem
        id="menu_school_class"
        name="Classes"
        parent="menu_team_settings"
        action="action_school_class"
        sequence="10"
    />
    <!-- Menu principal pour les rapports -->
    <menuitem id="menu_church_reports_main" 
              name="Rapports" 
              parent="base.menu_church_management_root"
              sequence="50"/>
    <!-- Sous-menu pour les listes de membres -->
    <menuitem id="menu_church_members_reports" 
              name="Listes de membres" 
              parent="menu_church_reports_main"
              sequence="10"/>
    <!-- Menu pour impression rapide des églises -->
    <menuitem id="menu_print_church_members" 
              name="Membres d'églises" 
              parent="menu_church_members_reports"
              action="action_print_church_members"
              sequence="10"/>
    <!-- Menu pour impression des tribus -->
    <menuitem id="menu_print_tribe_members" 
              name="Membres de tribus" 
              parent="menu_church_members_reports"
              action="action_print_tribe_members"
              sequence="20"/>
    <!-- Menu pour impression des cellules -->
    <menuitem id="menu_print_prayer_cell_members" 
              name="Membres de cellules" 
              parent="menu_church_members_reports"
              action="action_print_prayer_cell_members"
              sequence="30"/>
    <!-- Menu pour impression des groupes -->
    <menuitem id="menu_print_group_members" 
              name="Membres de groupes" 
              parent="menu_church_members_reports"
              action="action_print_group_members"
              sequence="40"/>
    <!-- Menu pour tableau de bord -->
    <menuitem id="menu_church_statistics_dashboard" 
              name="Tableau de bord" 
              parent="menu_church_statistics_reports"
              action="action_church_statistics_dashboard"
              sequence="10"/>
    <!-- Raccourcis rapides dans le menu principal -->
    <menuitem id="menu_quick_actions" 
              name="Actions rapides" 
              parent="base.menu_church_management_root"
              sequence="60"/>
    <!-- Menu pour actions rapides -->
    <menuitem id="menu_print_shortcuts" 
              name="Impressions rapides" 
              parent="menu_quick_actions"
              sequence="10"/>
</odoo>