<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Vue formulaire du wizard d'impression -->
    <record id="view_church_print_members_wizard_form" model="ir.ui.view">
        <field name="name">church.print.members.wizard.form</field>
        <field name="model">church.print.members.wizard</field>
        <field name="arch" type="xml">
            <form string="Options d'impression de la liste des membres">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="organization_id" readonly="1"/>
                        </h1>
                        <h2>
                            <span>Type : </span>
                            <field name="organization_type" readonly="1"/>
                        </h2>
                    </div>
                    
                    <notebook>
                        <!-- Onglet Filtres -->
                        <page string="Filtres" name="filters">
                            <group>
                                <group string="Filtrer par caractéristiques">
                                    <field name="filter_by_gender"/>
                                    <field name="gender_filter" invisible="not filter_by_gender"/>
                                    
                                    <field name="filter_by_age"/>
                                    <field name="min_age" invisible="not filter_by_age"/>
                                    <field name="max_age" invisible="not filter_by_age"/>
                                    
                                    <field name="filter_by_marital_status"/>
                                    <field name="marital_status_filter" invisible="not filter_by_marital_status"/>
                                </group>
                                
                                <group string="Filtres spéciaux">
                                    <field name="include_new_members_only"/>
                                    <field name="include_birthday_members"/>
                                </group>
                            </group>
                        </page>
                        
                        <!-- Onglet Options d'affichage -->
                        <page string="Affichage" name="display">
                            <group>
                                <group string="Informations à inclure">
                                    <field name="include_phone"/>
                                    <field name="include_email"/>
                                    <field name="include_profession"/>
                                    <field name="include_address"/>
                                </group>
                                
                                <group string="Options de tri">
                                    <field name="sort_by"/>
                                    <field name="sort_order"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                
                <footer>
                    <button name="action_print_filtered_list" string="Imprimer" type="object" class="btn-primary"/>
                    <button string="Annuler" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!-- Action pour ouvrir le wizard -->
    <record id="action_church_print_members_wizard" model="ir.actions.act_window">
        <field name="name">Options d'impression des membres</field>
        <field name="res_model">church.print.members.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <!-- Action pour wizard d'impression avancée -->
    <record id="action_advanced_print_wizard" model="ir.actions.act_window">
        <field name="name">Impression avancée</field>
        <field name="res_model">church.print.members.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smily_face">
                Utilisez cet assistant pour des impressions personnalisées avec filtres
            </p>
        </field>
    </record>

    <!-- Menu pour wizard d'impression avancée -->
    <menuitem id="menu_advanced_print_wizard" 
              name="Impression avancée" 
              parent="menu_church_members_reports"
              action="action_advanced_print_wizard"
              sequence="50"/>

    <!-- Sous-menu pour rapports statistiques -->
    <menuitem id="menu_church_statistics_reports" 
              name="Rapports statistiques" 
              parent="menu_church_reports_main"
              sequence="20"/>
</odoo>