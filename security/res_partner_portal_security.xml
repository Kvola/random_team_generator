<odoo>
    <record id="group_res_partner_portal" model="res.groups">
        <field name="name">Partenaire Portail</field>
        <field name="category_id" ref="base.module_category_hidden"/>
    </record>
    <!-- Groupe de sécurité pour l'impression des listes -->
    <record id="group_print_members_lists" model="res.groups">
        <field name="name">Impression des listes de membres</field>
        <field name="category_id" ref="base.module_category_church_management"/>
        <field name="comment">Permet d'imprimer les listes de membres des organisations</field>
    </record>

    <!-- Règles de sécurité pour le wizard -->
    <record id="church_print_members_wizard_rule" model="ir.rule">
        <field name="name">Church Print Members Wizard Rule</field>
        <field name="model_id" ref="model_church_print_members_wizard"/>
        <field name="domain_force">[(1, '=', 1)]</field>
        <field name="groups" eval="[(4, ref('group_print_members_lists'))]"/>
    </record>

    <!-- Permissions pour le modèle wizard -->
    <record id="access_church_print_members_wizard" model="ir.model.access">
        <field name="name">church.print.members.wizard</field>
        <field name="model_id" ref="model_church_print_members_wizard"/>
        <field name="group_id" ref="group_print_members_lists"/>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>