<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template compact pour impression rapide -->
    <template id="report_members_list_compact_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- En-tête compact -->
                        <div class="text-center mb-3">
                            <h3><strong>Liste des Membres - <span t-field="doc.name"/></strong></h3>
                            <p>
                                <span t-if="doc.organization_type == 'company'">Église</span>
                                <span t-if="doc.organization_type == 'tribe'">Tribu</span>
                                <span t-if="doc.organization_type == 'prayer_cell'">Cellule de prière</span>
                                <span t-if="doc.organization_type == 'group'">Groupe</span>
                                | <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y')"/>
                            </p>
                        </div>

                        <!-- Table compacte -->
                        <table class="table table-bordered table-sm" style="font-size: 0.85em;">
                            <thead class="thead-light">
                                <tr>
                                    <th style="width: 5%;">N°</th>
                                    <th style="width: 8%;">Code</th>
                                    <th style="width: 25%;">Nom</th>
                                    <th style="width: 8%;">Genre</th>
                                    <th style="width: 8%;">Âge</th>
                                    <th style="width: 20%;">Contact</th>
                                    <th style="width: 15%;">Profession</th>
                                    <th style="width: 11%;">Statut</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="members_list" t-value="doc._get_filtered_members_for_print(context)"/>
                                <tr t-foreach="members_list" t-as="member">
                                    <td class="text-center"><span t-esc="member_index + 1"/></td>
                                    <td class="text-center"><small><span t-field="member.unique_code"/></small></td>
                                    <td>
                                        <strong><span t-field="member.name"/></strong>
                                        <div t-if="member.is_new_member or member.is_birthday" style="font-size: 0.7em;">
                                            <span t-if="member.is_new_member" class="badge badge-info">N</span>
                                            <span t-if="member.is_birthday" class="badge badge-success">A</span>
                                        </div>
                                    </td>
                                    <td class="text-center">
                                        <span t-if="member.gender == 'male'">H</span>
                                        <span t-if="member.gender == 'female'">F</span>
                                    </td>
                                    <td class="text-center"><span t-field="member.age"/></td>
                                    <td style="font-size: 0.8em;">
                                        <div t-if="member.mobile"><span t-field="member.mobile"/></div>
                                        <div t-if="member.email" style="overflow: hidden; text-overflow: ellipsis;">
                                            <span t-field="member.email"/>
                                        </div>
                                    </td>
                                    <td style="font-size: 0.8em;"><span t-field="member.function"/></td>
                                    <td class="text-center" style="font-size: 0.7em;">
                                        <div t-if="member.marital_status == 'single'">Cél.</div>
                                        <div t-if="member.marital_status == 'married'">Mar.</div>
                                        <div t-if="member.marital_status == 'divorced'">Div.</div>
                                        <div t-if="member.marital_status == 'widowed'">Veuf</div>
                                        
                                        <!-- Rôles dans l'église -->
                                        <div t-if="member.is_pastor" class="badge badge-warning" style="font-size: 0.6em;">P</div>
                                        <div t-if="member.is_elder" class="badge badge-info" style="font-size: 0.6em;">A</div>
                                        <div t-if="member.is_deacon" class="badge badge-success" style="font-size: 0.6em;">D</div>
                                        <div t-if="member.is_leader" class="badge badge-danger" style="font-size: 0.6em;">R</div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Légende compacte -->
                        <div class="row mt-3" style="font-size: 0.8em;">
                            <div class="col-6">
                                <strong>Légende :</strong>
                                <span class="badge badge-info">N</span> Nouveau |
                                <span class="badge badge-success">A</span> Anniversaire |
                                H = Homme, F = Femme
                            </div>
                            <div class="col-6">
                                <strong>Rôles :</strong>
                                <span class="badge badge-warning">P</span> Pasteur |
                                <span class="badge badge-info">A</span> Ancien |
                                <span class="badge badge-success">D</span> Diacre |
                                <span class="badge badge-danger">R</span> Responsable
                            </div>
                        </div>

                        <!-- Résumé statistique compact -->
                        <div class="row mt-3 border-top pt-2" style="font-size: 0.9em;">
                            <div class="col-12">
                                <strong>Résumé : </strong>
                                Total : <span t-esc="len(members_list)"/> |
                                Hommes : <span t-esc="len(members_list.filtered(lambda m: m.gender == 'male'))"/> |
                                Femmes : <span t-esc="len(members_list.filtered(lambda m: m.gender == 'female'))"/> |
                                Nouveaux : <span t-esc="len(members_list.filtered(lambda m: m.is_new_member))"/> |
                                Enfants (≤12) : <span t-esc="len(members_list.filtered(lambda m: m.age and m.age &lt;= 12))"/> |
                                Jeunes (13-25) : <span t-esc="len(members_list.filtered(lambda m: m.age and 13 &lt;= m.age &lt;= 25))"/> |
                                Adultes (26+) : <span t-esc="len(members_list.filtered(lambda m: m.age and m.age >= 26))"/>
                            </div>
                        </div>

                        <!-- Espace pour signatures -->
                        <div class="row mt-4">
                            <div class="col-4 text-center">
                                <div style="border-bottom: 1px solid black; margin-bottom: 5px; height: 20px;"></div>
                                <small>Responsable</small>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-bottom: 1px solid black; margin-bottom: 5px; height: 20px;"></div>
                                <small>Secrétaire</small>
                            </div>
                            <div class="col-4 text-center">
                                <div style="border-bottom: 1px solid black; margin-bottom: 5px; height: 20px;"></div>
                                <small>Date</small>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Rapport compact -->
    <record id="report_members_list_compact" model="ir.actions.report">
        <field name="name">Liste des Membres (Compact)</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">church_management.report_members_list_compact_template</field>
        <field name="report_file">church_management.report_members_list_compact_template</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="base.paperformat_euro"/>
    </record>

    <!-- Template pour feuille de présence -->
    <template id="report_attendance_sheet_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <div class="text-center mb-4">
                            <h3><strong>Feuille de Présence</strong></h3>
                            <h4><span t-field="doc.name"/></h4>
                            <p>Date : _________________ | Événement : _______________________</p>
                        </div>

                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th style="width: 5%;">N°</th>
                                    <th style="width: 25%;">Nom complet</th>
                                    <th style="width: 10%;">Code</th>
                                    <th style="width: 15%;">Contact</th>
                                    <th style="width: 15%;">Présence</th>
                                    <th style="width: 30%;">Observations</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="members_list" t-value="doc._get_filtered_members_for_print(context)"/>
                                <tr t-foreach="members_list" t-as="member" style="height: 25px;">
                                    <td class="text-center"><span t-esc="member_index + 1"/></td>
                                    <td><span t-field="member.name"/></td>
                                    <td class="text-center"><span t-field="member.unique_code"/></td>
                                    <td><span t-field="member.mobile"/></td>
                                    <td class="text-center">☐</td>
                                    <td></td>
                                </tr>
                                <!-- Lignes vides supplémentaires -->
                                <tr t-foreach="range(5)" t-as="empty_row" style="height: 25px;">
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td></td>
                                    <td class="text-center">☐</td>
                                    <td></td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="mt-3">
                            <p><strong>Total membres inscrits :</strong> <span t-esc="len(members_list)"/></p>
                            <p><strong>Présents :</strong> _____ | <strong>Absents :</strong> _____ | <strong>Excusés :</strong> _____</p>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Rapport feuille de présence -->
    <record id="report_attendance_sheet" model="ir.actions.report">
        <field name="name">Feuille de Présence</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">church_management.report_attendance_sheet_template</field>
        <field name="report_file">church_management.report_attendance_sheet_template</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>
</odoo>