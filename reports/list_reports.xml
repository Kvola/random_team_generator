<odoo>
    <!-- 2. Créer un rapport pour l'impression -->
    <record id="report_members_list" model="ir.actions.report">
        <field name="name">Liste des Membres</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">church_management.report_members_list_template</field>
        <field name="report_file">church_management.report_members_list_template</field>
        <field name="binding_model_id" ref="base.model_res_partner"/>
        <field name="binding_type">report</field>
    </record>

    <!-- 3. Template du rapport -->
    <template id="report_members_list_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- En-tête du rapport -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2>
                                    <strong>Liste des Membres</strong>
                                </h2>
                                <h3 t-field="doc.name"/>
                                <p>
                                    <span t-if="doc.organization_type == 'company'">Église</span>
                                    <span t-if="doc.organization_type == 'tribe'">Tribu</span>
                                    <span t-if="doc.organization_type == 'prayer_cell'">Cellule de prière</span>
                                    <span t-if="doc.organization_type == 'group'">Groupe</span>
                                    <span t-if="doc.organization_type == 'communication'">Groupe de communication</span>
                                    <span t-if="doc.organization_type == 'artistic_group'">Groupe artistique</span>
                                    <span t-if="doc.organization_type == 'ngo'">ONG</span>
                                    <span t-if="doc.organization_type == 'school'">École</span>
                                    <span t-if="doc.organization_type == 'sports_group'">Groupe sportif</span>
                                    <span t-if="doc.organization_type == 'educational_group'">Groupe éducatif</span>
                                    <span t-if="doc.organization_type == 'other_group'">Groupe spécialisé</span>
                                </p>
                                <p><strong>Date d'impression :</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y à %H:%M')"/></p>
                            </div>
                        </div>

                        <!-- Informations sur l'organisation -->
                        <div class="row mb-3">
                            <div class="col-6">
                                <t t-if="doc.organization_type == 'company' and doc.main_pastor_id">
                                    <strong>Pasteur principal :</strong> <span t-field="doc.main_pastor_id.name"/>
                                </t>
                                <t t-if="doc.organization_type == 'tribe' and doc.tribe_church_id">
                                    <strong>Église :</strong> <span t-field="doc.tribe_church_id.name"/>
                                </t>
                                <t t-if="doc.organization_type == 'prayer_cell' and doc.prayer_cell_leader_id">
                                    <strong>Responsable :</strong> <span t-field="doc.prayer_cell_leader_id.name"/>
                                </t>
                                <t t-if="doc.organization_type == 'group' and doc.group_leader_id">
                                    <strong>Responsable :</strong> <span t-field="doc.group_leader_id.name"/>
                                </t>
                            </div>
                            <div class="col-6 text-right">
                                <t t-if="doc.organization_type == 'company'">
                                    <strong>Nombre de membres :</strong> <span t-esc="len(doc.company_contacts)"/>
                                </t>
                                <t t-if="doc.organization_type == 'tribe'">
                                    <strong>Nombre de membres :</strong> <span t-esc="len(doc.tribe_members)"/>
                                </t>
                                <t t-if="doc.organization_type == 'prayer_cell'">
                                    <strong>Nombre de membres :</strong> <span t-esc="len(doc.prayer_cell_members)"/>
                                </t>
                                <t t-if="doc.organization_type == 'group'">
                                    <strong>Nombre de membres :</strong> <span t-esc="len(doc.group_members)"/>
                                </t>
                            </div>
                        </div>

                        <!-- Table des membres -->
                        <table class="table table-bordered table-sm">
                            <thead class="thead-light">
                                <tr>
                                    <th>N°</th>
                                    <th>Code</th>
                                    <th>Nom complet</th>
                                    <th>Genre</th>
                                    <th>Âge</th>
                                    <th>État civil</th>
                                    <th>Téléphone</th>
                                    <th>Email</th>
                                    <th>Profession</th>
                                </tr>
                            </thead>
                            <tbody>
                                <!-- Membres de l'église -->
                                <t t-if="doc.organization_type == 'company'">
                                    <tr t-foreach="doc.company_contacts.sorted(key=lambda r: r.name)" t-as="member">
                                        <td><span t-esc="member_index + 1"/></td>
                                        <td><span t-field="member.unique_code"/></td>
                                        <td>
                                            <strong><span t-field="member.name"/></strong>
                                            <span t-if="member.is_new_member" class="badge badge-info ml-1">Nouveau</span>
                                            <span t-if="member.is_birthday" class="badge badge-success ml-1">Anniversaire</span>
                                        </td>
                                        <td>
                                            <span t-if="member.gender == 'male'">Homme</span>
                                            <span t-if="member.gender == 'female'">Femme</span>
                                        </td>
                                        <td><span t-field="member.age"/> ans</td>
                                        <td>
                                            <span t-if="member.marital_status == 'single'">Célibataire</span>
                                            <span t-if="member.marital_status == 'married'">Marié(e)</span>
                                            <span t-if="member.marital_status == 'divorced'">Divorcé(e)</span>
                                            <span t-if="member.marital_status == 'widowed'">Veuf/Veuve</span>
                                        </td>
                                        <td>
                                            <span t-field="member.mobile"/>
                                            <span t-if="member.phone and member.mobile"> / </span>
                                            <span t-field="member.phone"/>
                                        </td>
                                        <td><span t-field="member.email"/></td>
                                        <td><span t-field="member.function"/></td>
                                    </tr>
                                </t>

                                <!-- Membres de la tribu -->
                                <t t-if="doc.organization_type == 'tribe'">
                                    <tr t-foreach="doc.tribe_members.sorted(key=lambda r: r.name)" t-as="member">
                                        <td><span t-esc="member_index + 1"/></td>
                                        <td><span t-field="member.unique_code"/></td>
                                        <td>
                                            <strong><span t-field="member.name"/></strong>
                                            <span t-if="member.is_new_member" class="badge badge-info ml-1">Nouveau</span>
                                            <span t-if="member.is_birthday" class="badge badge-success ml-1">Anniversaire</span>
                                        </td>
                                        <td>
                                            <span t-if="member.gender == 'male'">Homme</span>
                                            <span t-if="member.gender == 'female'">Femme</span>
                                        </td>
                                        <td><span t-field="member.age"/> ans</td>
                                        <td>
                                            <span t-if="member.marital_status == 'single'">Célibataire</span>
                                            <span t-if="member.marital_status == 'married'">Marié(e)</span>
                                            <span t-if="member.marital_status == 'divorced'">Divorcé(e)</span>
                                            <span t-if="member.marital_status == 'widowed'">Veuf/Veuve</span>
                                        </td>
                                        <td>
                                            <span t-field="member.mobile"/>
                                            <span t-if="member.phone and member.mobile"> / </span>
                                            <span t-field="member.phone"/>
                                        </td>
                                        <td><span t-field="member.email"/></td>
                                        <td><span t-field="member.function"/></td>
                                    </tr>
                                </t>

                                <!-- Membres de la cellule de prière -->
                                <t t-if="doc.organization_type == 'prayer_cell'">
                                    <tr t-foreach="doc.prayer_cell_members.sorted(key=lambda r: r.name)" t-as="member">
                                        <td><span t-esc="member_index + 1"/></td>
                                        <td><span t-field="member.unique_code"/></td>
                                        <td>
                                            <strong><span t-field="member.name"/></strong>
                                            <span t-if="member.is_new_member" class="badge badge-info ml-1">Nouveau</span>
                                            <span t-if="member.is_birthday" class="badge badge-success ml-1">Anniversaire</span>
                                        </td>
                                        <td>
                                            <span t-if="member.gender == 'male'">Homme</span>
                                            <span t-if="member.gender == 'female'">Femme</span>
                                        </td>
                                        <td><span t-field="member.age"/> ans</td>
                                        <td>
                                            <span t-if="member.marital_status == 'single'">Célibataire</span>
                                            <span t-if="member.marital_status == 'married'">Marié(e)</span>
                                            <span t-if="member.marital_status == 'divorced'">Divorcé(e)</span>
                                            <span t-if="member.marital_status == 'widowed'">Veuf/Veuve</span>
                                        </td>
                                        <td>
                                            <span t-field="member.mobile"/>
                                            <span t-if="member.phone and member.mobile"> / </span>
                                            <span t-field="member.phone"/>
                                        </td>
                                        <td><span t-field="member.email"/></td>
                                        <td><span t-field="member.function"/></td>
                                    </tr>
                                </t>

                                <!-- Membres du groupe -->
                                <t t-if="doc.organization_type == 'group'">
                                    <tr t-foreach="doc.group_members.sorted(key=lambda r: r.name)" t-as="member">
                                        <td><span t-esc="member_index + 1"/></td>
                                        <td><span t-field="member.unique_code"/></td>
                                        <td>
                                            <strong><span t-field="member.name"/></strong>
                                            <span t-if="member.is_new_member" class="badge badge-info ml-1">Nouveau</span>
                                            <span t-if="member.is_birthday" class="badge badge-success ml-1">Anniversaire</span>
                                        </td>
                                        <td>
                                            <span t-if="member.gender == 'male'">Homme</span>
                                            <span t-if="member.gender == 'female'">Femme</span>
                                        </td>
                                        <td><span t-field="member.age"/> ans</td>
                                        <td>
                                            <span t-if="member.marital_status == 'single'">Célibataire</span>
                                            <span t-if="member.marital_status == 'married'">Marié(e)</span>
                                            <span t-if="member.marital_status == 'divorced'">Divorcé(e)</span>
                                            <span t-if="member.marital_status == 'widowed'">Veuf/Veuve</span>
                                        </td>
                                        <td>
                                            <span t-field="member.mobile"/>
                                            <span t-if="member.phone and member.mobile"> / </span>
                                            <span t-field="member.phone"/>
                                        </td>
                                        <td><span t-field="member.email"/></td>
                                        <td><span t-field="member.function"/></td>
                                    </tr>
                                </t>

                                <!-- Membres des groupes spécialisés (communication, artistique, etc.) -->
                                <t t-if="doc.organization_type == 'communication'">
                                    <tr t-foreach="doc.communication_members.sorted(key=lambda r: r.name)" t-as="member">
                                        <td><span t-esc="member_index + 1"/></td>
                                        <td><span t-field="member.unique_code"/></td>
                                        <td>
                                            <strong><span t-field="member.name"/></strong>
                                            <span t-if="member.is_new_member" class="badge badge-info ml-1">Nouveau</span>
                                        </td>
                                        <td>
                                            <span t-if="member.gender == 'male'">Homme</span>
                                            <span t-if="member.gender == 'female'">Femme</span>
                                        </td>
                                        <td><span t-field="member.age"/> ans</td>
                                        <td>
                                            <span t-if="member.marital_status == 'single'">Célibataire</span>
                                            <span t-if="member.marital_status == 'married'">Marié(e)</span>
                                            <span t-if="member.marital_status == 'divorced'">Divorcé(e)</span>
                                            <span t-if="member.marital_status == 'widowed'">Veuf/Veuve</span>
                                        </td>
                                        <td>
                                            <span t-field="member.mobile"/>
                                            <span t-if="member.phone and member.mobile"> / </span>
                                            <span t-field="member.phone"/>
                                        </td>
                                        <td><span t-field="member.email"/></td>
                                        <td><span t-field="member.function"/></td>
                                    </tr>
                                </t>

                                <!-- Ajouter les autres types de groupes de manière similaire -->
                                <!-- artistic_group, ngo, school, sports_group, educational_group, other_group -->
                                
                            </tbody>
                        </table>

                        <!-- Pied de page avec statistiques -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>Statistiques</h4>
                                <div class="row">
                                    <div class="col-3">
                                        <strong>Total membres :</strong>
                                        <span t-if="doc.organization_type == 'company'" t-esc="len(doc.company_contacts)"/>
                                        <span t-if="doc.organization_type == 'tribe'" t-esc="len(doc.tribe_members)"/>
                                        <span t-if="doc.organization_type == 'prayer_cell'" t-esc="len(doc.prayer_cell_members)"/>
                                        <span t-if="doc.organization_type == 'group'" t-esc="len(doc.group_members)"/>
                                        <span t-if="doc.organization_type == 'communication'" t-esc="len(doc.communication_members)"/>
                                    </div>
                                    <div class="col-3">
                                        <strong>Hommes :</strong>
                                        <span t-if="doc.organization_type == 'company'" t-esc="len(doc.company_contacts.filtered(lambda m: m.gender == 'male'))"/>
                                        <span t-if="doc.organization_type == 'tribe'" t-esc="len(doc.tribe_members.filtered(lambda m: m.gender == 'male'))"/>
                                        <span t-if="doc.organization_type == 'prayer_cell'" t-esc="len(doc.prayer_cell_members.filtered(lambda m: m.gender == 'male'))"/>
                                        <span t-if="doc.organization_type == 'group'" t-esc="len(doc.group_members.filtered(lambda m: m.gender == 'male'))"/>
                                    </div>
                                    <div class="col-3">
                                        <strong>Femmes :</strong>
                                        <span t-if="doc.organization_type == 'company'" t-esc="len(doc.company_contacts.filtered(lambda m: m.gender == 'female'))"/>
                                        <span t-if="doc.organization_type == 'tribe'" t-esc="len(doc.tribe_members.filtered(lambda m: m.gender == 'female'))"/>
                                        <span t-if="doc.organization_type == 'prayer_cell'" t-esc="len(doc.prayer_cell_members.filtered(lambda m: m.gender == 'female'))"/>
                                        <span t-if="doc.organization_type == 'group'" t-esc="len(doc.group_members.filtered(lambda m: m.gender == 'female'))"/>
                                    </div>
                                    <div class="col-3">
                                        <strong>Nouveaux membres :</strong>
                                        <span t-if="doc.organization_type == 'company'" t-esc="len(doc.company_contacts.filtered(lambda m: m.is_new_member))"/>
                                        <span t-if="doc.organization_type == 'tribe'" t-esc="len(doc.tribe_members.filtered(lambda m: m.is_new_member))"/>
                                        <span t-if="doc.organization_type == 'prayer_cell'" t-esc="len(doc.prayer_cell_members.filtered(lambda m: m.is_new_member))"/>
                                        <span t-if="doc.organization_type == 'group'" t-esc="len(doc.group_members.filtered(lambda m: m.is_new_member))"/>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Template amélioré avec gestion des filtres -->
    <template id="report_members_list_enhanced_template">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="web.external_layout">
                    <div class="page">
                        <!-- En-tête du rapport -->
                        <div class="row mb-4">
                            <div class="col-12 text-center">
                                <h2>
                                    <strong>Liste des Membres</strong>
                                    <span t-if="context.get('filter_applied')" class="badge badge-info ml-2">Filtrée</span>
                                </h2>
                                <h3 t-field="doc.name"/>
                                <p>
                                    <span t-if="doc.organization_type == 'company'">Église</span>
                                    <span t-if="doc.organization_type == 'tribe'">Tribu</span>
                                    <span t-if="doc.organization_type == 'prayer_cell'">Cellule de prière</span>
                                    <span t-if="doc.organization_type == 'group'">Groupe</span>
                                    <span t-if="doc.organization_type == 'communication'">Groupe de communication</span>
                                    <span t-if="doc.organization_type == 'artistic_group'">Groupe artistique</span>
                                    <span t-if="doc.organization_type == 'ngo'">ONG</span>
                                    <span t-if="doc.organization_type == 'school'">École</span>
                                    <span t-if="doc.organization_type == 'sports_group'">Groupe sportif</span>
                                    <span t-if="doc.organization_type == 'educational_group'">Groupe éducatif</span>
                                    <span t-if="doc.organization_type == 'other_group'">Groupe spécialisé</span>
                                </p>
                                <p><strong>Date d'impression :</strong> <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%d/%m/%Y à %H:%M')"/></p>
                            </div>
                        </div>

                        <!-- Informations sur l'organisation -->
                        <div class="row mb-3">
                            <div class="col-6">
                                <t t-if="doc.organization_type == 'company' and doc.main_pastor_id">
                                    <strong>Pasteur principal :</strong> <span t-field="doc.main_pastor_id.name"/>
                                </t>
                                <t t-if="doc.organization_type == 'tribe' and doc.tribe_church_id">
                                    <strong>Église :</strong> <span t-field="doc.tribe_church_id.name"/>
                                </t>
                                <t t-if="doc.organization_type == 'prayer_cell' and doc.prayer_cell_leader_id">
                                    <strong>Responsable :</strong> <span t-field="doc.prayer_cell_leader_id.name"/>
                                </t>
                                <t t-if="doc.organization_type == 'group' and doc.group_leader_id">
                                    <strong>Responsable :</strong> <span t-field="doc.group_leader_id.name"/>
                                </t>
                            </div>
                            <div class="col-6 text-right">
                                <!-- Le nombre sera calculé dynamiquement selon les filtres -->
                                <strong>Nombre de membres dans cette liste :</strong>
                                <span t-set="members_list" t-value="doc._get_filtered_members_for_print(context)"/>
                                <span t-esc="len(members_list)"/>
                            </div>
                        </div>

                        <!-- Table des membres avec colonnes conditionnelles -->
                        <table class="table table-bordered table-sm">
                            <thead class="thead-light">
                                <tr>
                                    <th>N°</th>
                                    <th>Code</th>
                                    <th>Nom complet</th>
                                    <th>Genre</th>
                                    <th>Âge</th>
                                    <th>État civil</th>
                                    <th t-if="context.get('include_phone', True)">Téléphone</th>
                                    <th t-if="context.get('include_email', True)">Email</th>
                                    <th t-if="context.get('include_profession', True)">Profession</th>
                                    <th t-if="context.get('include_address', False)">Adresse</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="members_to_display" t-value="doc._get_filtered_members_for_print(context)"/>
                                <tr t-foreach="members_to_display" t-as="member">
                                    <td><span t-esc="member_index + 1"/></td>
                                    <td><span t-field="member.unique_code"/></td>
                                    <td>
                                        <strong><span t-field="member.name"/></strong>
                                        <span t-if="member.is_new_member" class="badge badge-info ml-1">Nouveau</span>
                                        <span t-if="member.is_birthday" class="badge badge-success ml-1">Anniversaire</span>
                                    </td>
                                    <td>
                                        <span t-if="member.gender == 'male'">Homme</span>
                                        <span t-if="member.gender == 'female'">Femme</span>
                                    </td>
                                    <td><span t-field="member.age"/> ans</td>
                                    <td>
                                        <span t-if="member.marital_status == 'single'">Célibataire</span>
                                        <span t-if="member.marital_status == 'married'">Marié(e)</span>
                                        <span t-if="member.marital_status == 'divorced'">Divorcé(e)</span>
                                        <span t-if="member.marital_status == 'widowed'">Veuf/Veuve</span>
                                    </td>
                                    <td t-if="context.get('include_phone', True)">
                                        <span t-field="member.mobile"/>
                                        <span t-if="member.phone and member.mobile"> / </span>
                                        <span t-field="member.phone"/>
                                    </td>
                                    <td t-if="context.get('include_email', True)"><span t-field="member.email"/></td>
                                    <td t-if="context.get('include_profession', True)"><span t-field="member.function"/></td>
                                    <td t-if="context.get('include_address', False)">
                                        <span t-field="member.street"/>
                                        <span t-if="member.street2"> <span t-field="member.street2"/></span>
                                        <span t-if="member.city"> <span t-field="member.city"/></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Pied de page avec statistiques -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <h4>Statistiques</h4>
                                <div class="row">
                                    <div class="col-3">
                                        <strong>Total membres :</strong>
                                        <span t-esc="len(members_to_display)"/>
                                    </div>
                                    <div class="col-3">
                                        <strong>Hommes :</strong>
                                        <span t-esc="len(members_to_display.filtered(lambda m: m.gender == 'male'))"/>
                                    </div>
                                    <div class="col-3">
                                        <strong>Femmes :</strong>
                                        <span t-esc="len(members_to_display.filtered(lambda m: m.gender == 'female'))"/>
                                    </div>
                                    <div class="col-3">
                                        <strong>Nouveaux membres :</strong>
                                        <span t-esc="len(members_to_display.filtered(lambda m: m.is_new_member))"/>
                                    </div>
                                </div>
                                
                                <!-- Statistiques par âge -->
                                <div class="row mt-2">
                                    <div class="col-3">
                                        <strong>Enfants (0-12 ans) :</strong>
                                        <span t-esc="len(members_to_display.filtered(lambda m: m.age and m.age &lt;= 12))"/>
                                    </div>
                                    <div class="col-3">
                                        <strong>Jeunes (13-25 ans) :</strong>
                                        <span t-esc="len(members_to_display.filtered(lambda m: m.age and 13 &lt;= m.age &lt;= 25))"/>
                                    </div>
                                    <div class="col-3">
                                        <strong>Adultes (26-59 ans) :</strong>
                                        <span t-esc="len(members_to_display.filtered(lambda m: m.age and 26 &lt;= m.age &lt;= 59))"/>
                                    </div>
                                    <div class="col-3">
                                        <strong>Seniors (60+ ans) :</strong>
                                        <span t-esc="len(members_to_display.filtered(lambda m: m.age and m.age &gt;= 60))"/>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Signature et espace pour notes -->
                        <div class="row mt-5">
                            <div class="col-6">
                                <div class="text-center">
                                    <p>_______________________</p>
                                    <p><strong>Signature du responsable</strong></p>
                                </div>
                            </div>
                            <div class="col-6">
                                <div>
                                    <p><strong>Notes :</strong></p>
                                    <div style="border: 1px solid #ccc; height: 80px; width: 100%;"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </t>
            </t>
        </t>
    </template>

    <!-- Rapport amélioré -->
    <record id="report_members_list_enhanced" model="ir.actions.report">
        <field name="name">Liste des Membres (Avec filtres)</field>
        <field name="model">res.partner</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">church_management.report_members_list_enhanced_template</field>
